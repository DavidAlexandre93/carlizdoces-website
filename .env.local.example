# Copie para .env.local. Nunca use valores reais neste arquivo versionado.

# Frontend: somente valores explicitamente públicos podem usar o prefixo VITE_.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# Integrações server-side (Vercel Functions).
RESEND_API_KEY=re_EXEMPLO
CONTACT_FROM_EMAIL=Carliz Doces <site@seudominio.com>
CONTACT_TO_EMAIL=contato@seudominio.com
OPENAI_API_KEY=sk-EXEMPLO
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_MS=9000

# Observabilidade, privacidade e operação.
OTEL_SERVICE_NAME=carlizdoces-website-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer EXEMPLO
OTEL_SDK_DISABLED=true
METRICS_TOKEN=gere-um-token-longo
PRIVACY_HASH_SALT=gere-um-salt-aleatorio-longo
REQUIRED_DEPENDENCIES=supabase
APP_VERSION=0.1.0
