{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.cjs",
    "test:ci": "node --test --test-reporter=spec tests/**/*.test.cjs",
    "audit:high": "npm audit --audit-level=high",
    "generate:image-data": "node scripts/generate-image-data.mjs",
    "prestart": "npm run generate:image-data",
    "prebuild": "npm run generate:image-data",
    "postbuild": "cp -r public/* dist/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.9",
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "@react-three/fiber": "^9.4.0",
    "@react-three/drei": "^10.7.6",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^2.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.39.0",
    "babel-loader": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "minimatch": "^3.1.4",
    "qs": "^6.14.2"
  }
}
